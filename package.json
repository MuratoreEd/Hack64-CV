{
  "name": "sm64-invisible-wall-viewer",
  "private": true,
  "version": "1.2.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "description": "Interactive viewer that surfaces SM64 ROM hack invisible walls by faithfully reimplementing the game's collision engine and probing live emulator RAM.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p bridge",
    "build": "tsc --noEmit && vite build",
    "build:exe": "npm run typecheck && vite build && node scripts/buildExe.mjs",
    "exe": "powershell -NoProfile -ExecutionPolicy Bypass -File run-exe.ps1",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/makeShortcut.ps1",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "corpus": "vitest run --config vitest.corpus.config.ts",
    "corpus:fixtures": "vite-node scripts/makeFixtures.ts",
    "corpus:import": "node scripts/importCapture.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "@yao-pkg/pkg": "^6.21.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
